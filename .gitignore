# Local files and Python caches
.DS_Store
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.env
.env.*
!.env.example

# Outputs and earlier experiments are kept locally, outside the paper repository.
/runs/
/reports/
/figures/
/best/
/Documentatie/
/GHID_COMPLET_PROIECT.md
/Dockerfile
/.dockerignore
/environment.yml
/export_scripts_fixed_no_masks/
/export_scripts_fixed_no_masks.zip

# Only the paper's final 3,000-sample DC motor dataset and its generation code.
/MPC_dataset/*
!/MPC_dataset/mpc_qr_dataset/
/MPC_dataset/mpc_qr_dataset/*
!/MPC_dataset/mpc_qr_dataset/create_mpc_dataset.py
!/MPC_dataset/mpc_qr_dataset/enrich_qr_dataset_with_pqr.py
!/MPC_dataset/mpc_qr_dataset/recalibrate_existing_specs.py
!/MPC_dataset/mpc_qr_dataset/build_recalibrated_pqr_dataset.py
!/MPC_dataset/mpc_qr_dataset/mpc_pqr_dataset_realfit_3000_spec_midanchor/

# Training and evaluation code for the model described in the paper.
/MPC_src/*
!/MPC_src/dataset.py
!/MPC_src/model.py
!/MPC_src/train.py
!/MPC_src/evaluate_motor_pqr.py
!/MPC_src/generate_control_plots.py
